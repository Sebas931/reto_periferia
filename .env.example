# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.

# Obligatoria para el chat (no para demo.ts ni npm test).
ANTHROPIC_API_KEY=

# Modelo y esfuerzo (opcionales)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=120000

# Límites de costo (opcionales)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=600000
MAX_TOKENS_DIA=8000000
MAX_SESIONES=200

# Si se define, el link público pide esta clave (opcional)
ACCESS_KEY=

PORT=3000
